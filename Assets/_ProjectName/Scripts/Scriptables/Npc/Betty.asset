  npcType: 8
  animatorSkin: {fileID: 22100000, guid: ca689eed2c205794db3d58b448cc20d2, type: 2}
  conversations:
  - skinRequired: 2
    dialogNodes:
    - id: start
      text: "O-Oh, chef... \xBFQue hace por aqu\xED?"
      options:
      - text: Traje la comida de Mr President personalmente
        nextNodeId: chef1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: Busco a su lider
        nextNodeId: chef2
        requiredSkin: 0
        suspicionChange: 10
        isLie: 1
      endsConversation: 0
      actionID: 
    - id: chef1
      text: "\xBFY de casualidad no me trajo alguito?"
      options:
      - text: "Lo dej\xE9 en el sal\xF3n"
        nextNodeId: chef3
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: chef2
      text: "\xBFDon Armando?...Ay que pena, esto no es Ecomoda"
      options: []
      endsConversation: 1
      actionID: 
    - id: chef3
      text: Espereme ya vuelvo, no le diga a mr president.
      options: []
      endsConversation: 1
      actionID: Moverse
  - skinRequired: 3
    dialogNodes:
    - id: start
      text: "M-Mesero... yo no ped\xED nada..."
      options:
      - text: "Es cortes\xEDa del doctor."
        nextNodeId: waiter1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 1
      - text: Es comida humana
        nextNodeId: waiter2
        requiredSkin: 0
        suspicionChange: 10
        isLie: 1
      endsConversation: 0
      actionID: 
    - id: waiter1
      text: E-Entiendo... gracias.
      options: []
      endsConversation: 1
      actionID: 
    - id: waiter2
      text: "Ay c\xF3mo as\xED? Usted qui\xE9n es?"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 5
    dialogNodes:
    - id: start
      text: "D-Doctor... como me le va?. Me alegra mucho verlo por ac\xE1"
      options:
      - text: "Deber\xEDa estar en el sal\xF3n principal"
        nextNodeId: doc1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      - text: Lo mismo digo
        nextNodeId: doc2
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: doc1
      text: "Ay \xBFc\xF3mo as\xED? Si me dijeron que asistiera a la reun\xF3n, muy
        raro"
      options:
      - text: "Ret\xEDrese!."
        nextNodeId: doc3
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: doc2
      text: "\xA1Tan Divino!, aqu\xED le tengo el informe para la junta."
      options:
      - text: Faltan documentos.
        nextNodeId: doc4
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: doc3
      text: "Ser\xE9 fea pero no bruta, aqu\xED pasa algo raro."
      options: []
      endsConversation: 1
      actionID: Moverse
    - id: doc4
      text: "Ay que pena, tal vez los dej\xE9 en el sal\xF3n"
      options:
      - text: "Ret\xEDrese!."
        nextNodeId: doc3
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 1
      actionID: Moverse
  - skinRequired: 6
    dialogNodes:
    - id: start
      text: "S-Se\xF1or presidente..."
      options:
      - text: "\xBFQu\xE9 hace aqu\xED una Latina?"
        nextNodeId: pres1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: pres1
      text: "Ya tengo en tr\xE1mite los papeles..."
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 7
    dialogNodes:
    - id: start
      text: "D-Doctor... \xBFnecesita algo m\xE1s?"
      options:
      - text: No estorbe.
        nextNodeId: bur21
        requiredSkin: 0
        suspicionChange: 5
        isLie: 0
      - text: "Qu\xE9dese aqu\xED."
        nextNodeId: bur22
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: bur21
      text: "P-Perd\xF3n, doctor. Ya me retiro"
      options: []
      endsConversation: 1
      actionID: Moverse
    - id: bur22
      text: "S-S\xED, doctor."
      options: []
      endsConversation: 1
      actionID: 
  defaultConversation:
  - id: start
    text: L-Lo siento... estoy ocupada.
    options: []
    endsConversation: 1
    actionID: 
  scaredConversation:
  - id: start
    text: "\xA1Mi rostro! \xA1\xBFQu\xE9 me pas\xF3?!"
