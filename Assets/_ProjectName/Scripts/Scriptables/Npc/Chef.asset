  npcType: 2
  animatorSkin: {fileID: 22100000, guid: 37439f5df9b91014da9e8099407d89b1, type: 2}
  conversations:
  - skinRequired: 1
    dialogNodes:
    - id: start
      text: "\xBF\xA1Qu\xE9 demonios eres t\xFA!? \xBFC\xF3mo saliste de esa caja?"
      options:
      - text: Soy el nuevo ayudante.
        nextNodeId: lie1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 1
      - text: No soy una amenaza.
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 0
      - text: "*ruido alien\xEDgena extra\xF1o*"
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 20
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: lie1
      text: "\xA1Yo no contrat\xE9 a ninguna cosa verde!"
      options:
      - text: "Me envi\xF3 el presidente."
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 20
        isLie: 1
      - text: Puedo cocinar.
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 1
      endsConversation: 0
      actionID: betty
    - id: panic1
      text: "\xA1Guardias! \xA1Hay una cosa horrible en la despensa!"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 2
    dialogNodes:
    - id: start
      text: "\xBFQu\xE9 haces ah\xED parado? Tenemos \xF3rdenes presidenciales."
      options:
      - text: Ya estoy cocinando.
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "El mesero est\xE1 exagerando."
        nextNodeId: neutral1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: No voy a cocinar.
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: good1
      text: "Eso quiero o\xEDr. Mu\xE9vete."
      options: []
      endsConversation: 1
      actionID: 
    - id: neutral1
      text: "Que presione lo que quiera. Aqu\xED se cocina con orden."
      options: []
      endsConversation: 1
      actionID: 
    - id: bad1
      text: "\xBFTe volviste loco?"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 3
    dialogNodes:
    - id: start
      text: "\xBFYa entregaste todos los platos?"
      options:
      - text: "S\xED, ya descans\xE9 un momento."
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "Los bur\xF3cratas se quejan demasiado."
        nextNodeId: neutral1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: No hay pedidos hoy.
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 1
      endsConversation: 0
      actionID: 
    - id: good1
      text: "Bien. No quiero m\xE1s presi\xF3n hoy."
      options: []
      endsConversation: 1
      actionID: 
    - id: neutral1
      text: Que se quejen. Nosotros trabajamos.
      options: []
      endsConversation: 1
      actionID: 
    - id: bad1
      text: "\xBFC\xF3mo que no hay pedidos?"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 5
    dialogNodes:
    - id: start
      text: "\xBFQu\xE9 hace un bur\xF3crata en mi cocina?"
      options:
      - text: "Inspecci\xF3n r\xE1pida."
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "Busco algo espec\xEDfico."
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: good1
      text: "Hazlo r\xE1pido."
      options: []
      endsConversation: 1
      actionID: 
    - id: bad1
      text: Eso no me gusta.
      options: []
      endsConversation: 1
      actionID: 
  defaultConversation:
  - id: start
    text: Estoy ocupado.
    options: []
    endsConversation: 1
    actionID: 
