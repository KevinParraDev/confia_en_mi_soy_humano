%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9d971bea71cd0b44b2c4e2fce537977, type: 3}
  m_Name: Chef
  m_EditorClassIdentifier: 
  npcType: 2
  animatorSkin: {fileID: 22100000, guid: 37439f5df9b91014da9e8099407d89b1, type: 2}
  conversations:
  - skinRequired: 1
    dialogNodes:
    - id: start
      text: "¿¡Qué demonios eres tú!? ¿Cómo saliste de esa caja?"
      options:
      - text: "Soy el nuevo ayudante."
        nextNodeId: lie1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 1
      - text: "No soy una amenaza."
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 0
      - text: "*ruido alienígena extraño*"
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 20
        isLie: 0
      endsConversation: 0
    - id: lie1
      text: "¡Yo no contraté a ninguna cosa verde!"
      options:
      - text: "Me envió el presidente."
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 20
        isLie: 1
      - text: "Puedo cocinar."
        nextNodeId: panic1
        requiredSkin: 0
        suspicionChange: 15
        isLie: 1
      endsConversation: 0
    - id: panic1
      text: "¡Guardias! ¡Hay una cosa horrible en la despensa!"
      options: []
      endsConversation: 1
  - skinRequired: 2
    dialogNodes:
    - id: start
      text: "¿Qué haces ahí parado? Tenemos órdenes presidenciales."
      options:
      - text: "Ya estoy cocinando."
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "El mesero está exagerando."
        nextNodeId: neutral1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "No voy a cocinar."
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
    - id: good1
      text: "Eso quiero oír. Muévete."
      options: []
      endsConversation: 1
    - id: neutral1
      text: "Que presione lo que quiera. Aquí se cocina con orden."
      options: []
      endsConversation: 1
    - id: bad1
      text: "¿Te volviste loco?"
      options: []
      endsConversation: 1
  - skinRequired: 3
    dialogNodes:
    - id: start
      text: "¿Ya entregaste todos los platos?"
      options:
      - text: "Sí, ya descansé un momento."
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "Los burócratas se quejan demasiado."
        nextNodeId: neutral1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "No hay pedidos hoy."
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 1
      endsConversation: 0
    - id: good1
      text: "Bien. No quiero más presión hoy."
      options: []
      endsConversation: 1
    - id: neutral1
      text: "Que se quejen. Nosotros trabajamos."
      options: []
      endsConversation: 1
    - id: bad1
      text: "¿Cómo que no hay pedidos?"
      options: []
      endsConversation: 1
  - skinRequired: 5
    dialogNodes:
    - id: start
      text: "¿Qué hace un burócrata en mi cocina?"
      options:
      - text: "Inspección rápida."
        nextNodeId: good1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "Busco algo específico."
        nextNodeId: bad1
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
    - id: good1
      text: "Hazlo rápido."
      options: []
      endsConversation: 1
    - id: bad1
      text: "Eso no me gusta."
      options: []
      endsConversation: 1
  defaultConversation:
  - id: start
    text: "Estoy ocupado."
    options: []
    endsConversation: 1
  scaredConversation:
  - id: start
    text: "¡¿Por qué tengo esta cara?! ¡¿Qué me hiciste?!"
    options: []
    endsConversation: 1
  shortAfterFirstTalkConversation:
  - id: start
    text: "No tengo tiempo para repetir lo mismo."
    options: []
    endsConversation: 1
  maskIcon: {fileID: 4866018130364743319, guid: 4c8996810926d954ea09b3d8226ac5fe, type: 3}
