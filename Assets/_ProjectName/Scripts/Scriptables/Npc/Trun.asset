  m_Script: {fileID: 11500000, guid: a9d971bea71cd0b44b2c4e2fce537977, type: 3}
  m_Name: Trun
  m_EditorClassIdentifier: 
  npcType: 6
  animatorSkin: {fileID: 22100000, guid: 7047bd1574c5303459dc7b9681d49bc1, type: 2}
  conversations:
  - skinRequired: 2
    dialogNodes:
    - id: start
      text: Espero una comida igual de grande que America
      options:
      - text: "Ser\xE1 inolvidable."
        nextNodeId: chef1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: Es lo que hay.
        nextNodeId: chef2
        requiredSkin: 0
        suspicionChange: 10
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: chef1
      text: Eso me gusta. Grandes cosas.
      options: []
      endsConversation: 1
      actionID: 
    - id: chef2
      text: "No me gusta esa actitud. \xBFAcaso eres latino?"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 3
    dialogNodes:
    - id: start
      text: "Mesero. R\xE1pido. El mundo podr\xE1 morir de hambre, pero no nosotros."
      options:
      - text: "Enseguida, se\xF1or."
        nextNodeId: waiter1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: "Qu\xE9 horror"
        nextNodeId: waiter2
        requiredSkin: 0
        suspicionChange: 20
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: waiter1
      text: Bien. Eficiencia. Me agrada.
      options: []
      endsConversation: 1
      actionID: 
    - id: waiter2
      text: "Cuidado, eso solo lo dir\xEDa un comunista!"
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 5
    dialogNodes:
    - id: start
      text: Necesito resultados enormes. Tan enormes como America.
      options:
      - text: "Todo est\xE1 bajo control."
        nextNodeId: bur1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      - text: Hay complicaciones.
        nextNodeId: bur2
        requiredSkin: 0
        suspicionChange: 5
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: bur1
      text: "Ahora lleven libertad a otro pa\xEDs o algo."
      options: []
      endsConversation: 1
      actionID: 
    - id: bur2
      text: No me gustan las complicaciones. Ni los Latinos.
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 7
    dialogNodes:
    - id: start
      text: "He o\xEDdo cosas. No me gustan las cosas que oigo."
      options:
      - text: Rumores sin importancia.
        nextNodeId: bur3
        requiredSkin: 0
        suspicionChange: 10
        isLie: 1
      - text: "Todo est\xE1 perfecto."
        nextNodeId: bur4
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: bur3
      text: "Rumores? C\xF3mo los de Joffrey?"
      options: []
      endsConversation: 1
      actionID: 
    - id: bur4
      text: Perfecto es lo que me gusta.
      options: []
      endsConversation: 1
      actionID: 
  - skinRequired: 8
    dialogNodes:
    - id: start
      text: "Oh Miss Betty, \xBFNo pensar\xE1 presentar los balances reales verdad?"
      options:
      - text: "N-No se\xF1or presidente."
        nextNodeId: bety1
        requiredSkin: 0
        suspicionChange: 0
        isLie: 0
      endsConversation: 0
      actionID: 
    - id: bety1
      text: Eso espero, no me haga llamar a ICE
      options: []
      endsConversation: 1
      actionID: 
  defaultConversation:
  - id: start
    text: Estoy ocupado haciendo cosas enormes, enormes como AMERICA.
    options: []
    endsConversation: 1
    actionID: 
  scaredConversation:
  - id: start
    text: "\xBFQu\xE9 es esto? \xA1Esto es terrible! \xA1Arreglen esto ahora!"
    options: []
    endsConversation: 1
    actionID: 
  shortAfterFirstTalkConversation:
  - id: start
    text: Ya hablamos. Grandes conversaciones.
    options: []
    endsConversation: 1
    actionID: 
